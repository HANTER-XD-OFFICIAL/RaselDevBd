# Headless CMS Configuration for Rasel Dev BD (React + GitHub Pages)
# Set VITE_CMS_PROVIDER to "CONTENTFUL" or "STRAPI"
VITE_CMS_PROVIDER=CONTENTFUL

# Contentful Headless CMS (Content Delivery API + Content Management API)
VITE_CONTENTFUL_SPACE_ID=YOUR_CONTENTFUL_SPACE_ID
VITE_CONTENTFUL_ENVIRONMENT=master
VITE_CONTENTFUL_DELIVERY_TOKEN=YOUR_CONTENTFUL_DELIVERY_TOKEN
VITE_CONTENTFUL_MANAGEMENT_TOKEN=YOUR_CONTENTFUL_MANAGEMENT_TOKEN

# Strapi v4/v5 Headless CMS (REST API)
VITE_STRAPI_BASE_URL=https://cms.raseldevbd.com
VITE_STRAPI_API_TOKEN=YOUR_STRAPI_API_TOKEN
