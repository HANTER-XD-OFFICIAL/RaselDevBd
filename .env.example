# Headless CMS Configuration for Rasel Dev BD (Contentful & Strapi)
# Configure these values in the Secrets panel in AI Studio.
# Active CMS provider: "CONTENTFUL" or "STRAPI"
CMS_PROVIDER=CONTENTFUL

# Contentful Headless CMS Keys (Content Delivery API + Content Management API)
CONTENTFUL_SPACE_ID=YOUR_CONTENTFUL_SPACE_ID
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=YOUR_CONTENTFUL_DELIVERY_TOKEN
CONTENTFUL_MANAGEMENT_TOKEN=YOUR_CONTENTFUL_MANAGEMENT_TOKEN

# Strapi Headless CMS Keys (REST API v4/v5)
STRAPI_BASE_URL=https://cms.raseldevbd.com
STRAPI_API_TOKEN=YOUR_STRAPI_API_TOKEN

# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
